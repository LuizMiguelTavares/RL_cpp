{
  "run_name": "run_10x10_off",
  "resume": true,

  "environment": {
    "width": 10,
    "height": 10,
    "obstacle_density": 0.22,
    "obstacle_mode": "cluster",
    "seed": 30,
    "cluster_size": 5,
    "start_row": 0,
    "start_col": 0,
    "goal_row": -1,
    "goal_col": -1,
    "allow_diagonal": false,
    "diagonal_cost": -0.014,
    "reward_goal": 100.0,
    "reward_obstacle": -10.0,
    "reward_step": -0.01,
    "shaping": "euclidean",
    "ensure_solvable": true,
    "obstacle_generation_tries": 100
  },

  "agent": {
    "gamma": 0.99,
    "epsilon_behavior": 0.8,
    "visit_mode": "every_visit",
    "control_mode": "off_policy",
    "importance_sampling": "weighted",
    "seed": 42
  },

  "training": {
    "episodes_this_run": 10000000,
    "max_steps": 3000,
    "print_every": 45000,
    "flush_every": 1000,

    "checkpoint_every": 100000,

    "snapshot_every": 0,
    "snapshot_schedule": [
      { "until": 10000, "every": 50 },
      { "until": 100000, "every": 500 },
      { "until": 1000000, "every": 5000 },
      { "until": 10000000, "every": 10000 }
    ]
  }
}
